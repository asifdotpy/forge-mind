# Notion Integration Token (v2) — REQUIRED by scripts/sync_notion_brain.py
#
# How to create one:
#   1. Go to https://www.notion.so/my-integrations → New integration.
#   2. Associate it with the workspace that hosts the ForgeMind Knowledge Base.
#   3. Share the target pages/databases with the integration.
#
# Usage:
#   Copy this file to `.env` (gitignored) and fill in the real value:
#     cp .env.example .env
#   scripts/sync_notion_brain.py auto-loads this project-root `.env` at startup,
#   so you can then simply run:
#     python scripts/sync_notion_brain.py
#   (Alternatively, export NOTION_TOKEN="..."; a real environment variable
#   always takes precedence over the `.env` file.)
#
# NEVER commit a real token. This repository has a ggshield pre-commit hook
# that blocks commits containing secrets.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx