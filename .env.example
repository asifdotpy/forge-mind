# ForgeMind — environment template
#
# Copy to `.env` (gitignored) and fill in real values:
#     cp .env.example .env
#
# Precedence: a real exported environment variable ALWAYS wins over `.env`.
# In Cloud Run, set these as service env vars / Secret Manager refs instead.
#
# NEVER commit real secrets. A ggshield pre-commit hook blocks commits that
# contain them (see docs/FAILURE_LOG.md FAIL-003).
# Only THIS file (.env.example) is tracked; .env and .env*.local are ignored.

# =============================================================================
# Notion — development-time Knowledge Brain (ADR-009)
# =============================================================================
# REQUIRED by scripts/sync_notion_brain.py. Dev-time only; the runtime and the
# production image never read this.
#
# Create one at https://www.notion.so/my-integrations → New integration,
# associate it with the ForgeMind workspace, then share the target pages
# with the integration.
NOTION_TOKEN=ntn_xx...xxxx

# Optional: relocate the auto-loaded env file (default: project-root `.env`).
# NOTION_ENV_FILE=/absolute/path/to/.env

# =============================================================================
# Google Cloud — M2 deployment (ADR-001, ADR-002)
# =============================================================================
# Dedicated ForgeMind project, created 2026-08-24. Deliberately separate from
# any other project: own IAM, quotas, logs, and Artifact Registry.
# The project ID is permanent and cannot be renamed.
GCP_PROJECT_ID=forgemind-v3-prod
GCP_PROJECT_NUMBER=235225823709
GCP_REGION=us-central1

# Cloud Run service + Artifact Registry repo used by deploy/deploy.sh and
# deploy/cloudbuild.yaml (these are the defaults those files already assume).
CLOUD_RUN_SERVICE=forgemind
ARTIFACT_REGISTRY_REPO=cloud-run-source-deploy

# Default Compute Engine service account for this project — the identity the
# Cloud Run revision runs as. deploy/deploy.sh grants it artifactregistry.reader.
CLOUD_RUN_RUNTIME_SA=235225823709-compute@developer.gserviceaccount.com

# Billing account linked to the project (identifier only — not a credential).
GCP_BILLING_ACCOUNT=019AC6-E684EF-66567F

# Populated after the first successful deploy (T700):
#   gcloud run services describe forgemind --region us-central1 \
#     --format='value(status.url)'
# CLOUD_RUN_SERVICE_URL=https://forgemind-xxxxxxxxxx-uc.a.run.app

# =============================================================================
# Runtime service configuration
# =============================================================================
# Cloud Run injects PORT; 8080 is the local-parity default (see Dockerfile).
PORT=8080
LOG_LEVEL=INFO

# =============================================================================
# Vertex AI / ADK 2 — NOT YET INTEGRATED (ADR-008, Phase 9 / T900)
# =============================================================================
# Placeholders only. No runtime code imports google.adk or vertexai today;
# the five-tier DAG is a pure deterministic Python control plane. Runtime
# ChromaDB is likewise deferred to post-M3 per ADR-009.
#
# Keep FORGEMIND_ENABLE_ADK=false until T905 proves the full deterministic
# test suite still passes with ADK orchestration active.
FORGEMIND_ENABLE_ADK=false
# VERTEX_AI_LOCATION=us-central1
# VERTEX_AI_MODEL=gemini-3.5-pro
# GOOGLE_GENAI_USE_VERTEXAI=true

# =============================================================================
# Pub/Sub event ingestion — NOT YET IMPLEMENTED (ADR-001, Phase 8 / T800)
# =============================================================================
# Planned push subscription target: POST /api/v1/events
# PUBSUB_TOPIC=forgemind-events
# PUBSUB_SUBSCRIPTION=forgemind-events-push
