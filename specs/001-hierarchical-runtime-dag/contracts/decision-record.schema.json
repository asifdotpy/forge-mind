{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgemind.dev/specs/decision-record.schema.json",
  "title": "DecisionRecord",
  "type": "object",
  "required": [
    "decision_record_id",
    "validated_situation_id",
    "decision",
    "rationale",
    "risk_level",
    "autonomy_class",
    "confidence",
    "uncertainties",
    "requires_human"
  ],
  "properties": {
    "decision_record_id": { "type": "string", "pattern": "^DR-[A-Za-z0-9-]+$" },
    "validated_situation_id": { "type": "string", "pattern": "^VS-[A-Za-z0-9-]+$" },
    "decision": { "type": "string" },
    "rationale": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "autonomy_class": {
      "type": "string",
      "enum": ["safe_autonomous", "human_review", "escalate"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "requires_human": { "type": "boolean" }
  }
}