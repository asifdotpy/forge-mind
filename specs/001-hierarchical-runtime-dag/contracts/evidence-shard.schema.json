{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgemind.dev/specs/evidence-shard.schema.json",
  "title": "EvidenceShard",
  "type": "object",
  "required": [
    "evidence_shard_id",
    "situation_id",
    "worker",
    "domain",
    "observations",
    "claims",
    "evidence_ids",
    "confidence",
    "risk_level",
    "uncertainties",
    "affected_entities",
    "provenance",
    "execution_trace_id"
  ],
  "properties": {
    "evidence_shard_id": { "type": "string", "pattern": "^ES-[A-Za-z0-9-]+$" },
    "situation_id": { "type": "string", "pattern": "^SIT-[A-Za-z0-9-]+$" },
    "worker": { "type": "string" },
    "domain": { "type": "string", "enum": ["code", "delivery", "production"] },
    "observations": { "type": "array", "items": { "type": "string" } },
    "claims": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "affected_entities": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "execution_trace_id": { "type": "string", "pattern": "^TRC-[A-Za-z0-9-]+$" }
  }
}