{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgemind.dev/specs/validated-situation.schema.json",
  "title": "ValidatedSituation",
  "type": "object",
  "required": [
    "validated_situation_id",
    "situation_id",
    "finding_ids",
    "evidence_ids",
    "supporting_evidence",
    "conflicting_evidence",
    "coverage",
    "deduplication",
    "correlations",
    "causality_status",
    "confidence",
    "uncertainties",
    "validation_notes"
  ],
  "properties": {
    "validated_situation_id": { "type": "string", "pattern": "^VS-[A-Za-z0-9-]+$" },
    "situation_id": { "type": "string", "pattern": "^SIT-[A-Za-z0-9-]+$" },
    "finding_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "supporting_evidence": { "type": "array", "items": { "type": "string" } },
    "conflicting_evidence": { "type": "array", "items": { "type": "string" } },
    "coverage": { "type": "object" },
    "deduplication": { "type": "array", "items": { "type": "string" } },
    "correlations": { "type": "array", "items": { "type": "string" } },
    "causality_status": {
      "type": "string",
      "enum": ["unsupported", "correlated", "supported", "verified"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "validation_notes": { "type": "array", "items": { "type": "string" } }
  }
}