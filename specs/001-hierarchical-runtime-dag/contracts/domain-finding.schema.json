{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgemind.dev/specs/domain-finding.schema.json",
  "title": "DomainFinding",
  "type": "object",
  "required": [
    "finding_id",
    "situation_id",
    "domain",
    "evidence_shard_ids",
    "summary",
    "supported_claims",
    "conflicts",
    "coverage",
    "confidence",
    "uncertainties"
  ],
  "properties": {
    "finding_id": { "type": "string", "pattern": "^FND-[A-Za-z0-9-]+$" },
    "situation_id": { "type": "string", "pattern": "^SIT-[A-Za-z0-9-]+$" },
    "domain": { "type": "string", "enum": ["code", "delivery", "production"] },
    "evidence_shard_ids": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "supported_claims": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "coverage": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  }
}