{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgemind.dev/specs/coverage-plan.schema.json",
  "title": "CoveragePlan",
  "type": "object",
  "required": [
    "coverage_plan_id",
    "situation_id",
    "selected_domains",
    "selected_managers",
    "selected_workers",
    "selection_rationale",
    "excluded_workers",
    "coverage_requirements",
    "global_constraints",
    "expected_artifacts",
    "provenance",
    "execution_trace_id"
  ],
  "properties": {
    "coverage_plan_id": { "type": "string", "pattern": "^CP-[A-Za-z0-9-]+$" },
    "situation_id": { "type": "string", "pattern": "^SIT-[A-Za-z0-9-]+$" },
    "selected_domains": {
      "type": "array",
      "items": { "type": "string", "enum": ["code", "delivery", "production"] }
    },
    "selected_managers": { "type": "array", "items": { "type": "string" } },
    "selected_workers": { "type": "array", "items": { "type": "string" } },
    "selection_rationale": { "type": "array", "items": { "type": "string" } },
    "excluded_workers": { "type": "array", "items": { "type": "string" } },
    "coverage_requirements": { "type": "object" },
    "global_constraints": { "type": "object" },
    "expected_artifacts": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "execution_trace_id": { "type": "string", "pattern": "^TRC-[A-Za-z0-9-]+$" }
  }
}